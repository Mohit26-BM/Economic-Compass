# Copy to .env and fill in. Only FRED_API_KEY is needed, and only to re-run ingestion; the
# committed warehouse already holds the data, so the API and dashboard run without any key.

# Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_fred_api_key_here

DUCKDB_PATH=./data/warehouse.duckdb
MODEL_ARTIFACTS_PATH=./ml/artifacts

API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated sites allowed to call the API from a browser. Default (unset) is any site,
# which suits a public read-only API. Set it to your dashboard address to lock it down.
# ALLOWED_ORIGINS=https://your-dashboard.example.com

# Number of reverse proxies in front of the API (Render, Vercel, nginx = 1). Rate limits trust
# X-Forwarded-For only when this is above 0. Leave 0 when the API is reached directly.
# TRUSTED_PROXY_HOPS=1

# Requests per visitor per minute (defaults shown)
# SIMULATE_RATE_PER_MIN=30
# READ_RATE_PER_MIN=120
